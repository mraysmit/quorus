# =============================================================================
# Docker build context exclusions for Quorus
# Reduces context transfer from ~100MB to ~10MB per build.
# =============================================================================

# Build outputs. Images package host-built artifacts only; nothing is compiled inside Docker.
# Everything under target/ is excluded except the runtime jars the Dockerfiles copy.
**/target/
!quorus-controller/target/
quorus-controller/target/*
!quorus-controller/target/quorus-controller-*.jar
!quorus-agent/target/
quorus-agent/target/*
!quorus-agent/target/quorus-agent-*.jar
!quorus-agent/target/lib/

# Version control
.git/

# IDE / editor state
.idea/
.history/
.vscode/
**/*.iml

# Runtime data (not needed for image builds)
data/
logs/
downloads/
corporate-data/
temp/

# Documentation
docs/
docs-design/

# Docker compose configs (not needed inside image builds)
docker/

# Scripts
scripts/

# Root-level files not needed for builds
*.json
LICENSE
NOTICE
OPEN_SOURCE_USAGE.md
