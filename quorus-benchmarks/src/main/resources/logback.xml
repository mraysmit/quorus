<?xml version="1.0" encoding="UTF-8"?>
<!-- Benchmark runs log to the console only. This file takes precedence over the controller jar's
     logback.xml, which writes rolling files under /app/logs for the container image. -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{30} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="dev.mars.quorus.benchmarks" level="INFO"/>
    <logger name="dev.mars.quorus" level="WARN"/>
    <logger name="io.grpc" level="WARN"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="io.vertx" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
