<?xml version="1.0" encoding="UTF-8"?>
<!-- Logging for controller processes started by benchmark B-08: warnings and errors to the console,
     which the harness redirects to <work>/<node>/controller.log. Replaces the image's file logging. -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{30} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
